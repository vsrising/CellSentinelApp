<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="智能体"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="?attr/textAppearanceTitleMedium">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:paddingEnd="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export_pdf"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="导出PDF"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite60"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_agent_clear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清空"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite60" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_agent_settings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite60" />

        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Context data card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_context"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:visibility="gone"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/colorPrimaryContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_context_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="已附加分析数据"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/colorOnPrimaryContainer" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Chat messages -->
    <ScrollView
        android:id="@+id/sv_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingVertical="4dp">

        <LinearLayout
            android:id="@+id/ll_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp" />

    </ScrollView>

    <!-- Typing indicator -->
    <TextView
        android:id="@+id/tv_typing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="2dp"
        android:text="AI 正在思考…"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/colorAccent"
        android:textStyle="italic"
        android:visibility="gone" />

    <!-- Input row with rounded outlined text field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@color/colorSurfaceContainerLow">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入问题…"
            style="@style/AppTextInput"
            android:layout_marginEnd="8dp"
            app:boxCornerRadiusBottomEnd="22dp"
            app:boxCornerRadiusBottomStart="22dp"
            app:boxCornerRadiusTopEnd="22dp"
            app:boxCornerRadiusTopStart="22dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_agent_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:imeOptions="actionSend" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_agent_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="→"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/colorPrimary"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>
