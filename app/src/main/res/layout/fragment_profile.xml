<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- User info card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="用户信息"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tv_nick_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="14sp"
                    android:paddingTop="8dp" />

                <TextView
                    android:id="@+id/tv_login_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未登录"
                    android:textSize="13sp"
                    android:textColor="@color/textColorSecondary"
                    android:paddingTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Server settings card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务器设置"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimary" />

                <EditText
                    android:id="@+id/et_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="主服务器地址（如 http://192.168.1.1:8080）"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/et_backup_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="备用服务器地址（可留空）"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btn_save_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="保存"
                    android:textAllCaps="false"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数据上报"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimary" />

                <Button
                    android:id="@+id/btn_upload_signal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="立即上报当前信号快照"
                    android:textAllCaps="false"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hermes AI settings card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hermes AI 设置"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimary" />

                <EditText
                    android:id="@+id/et_hermes_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="AI 接口地址"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/et_hermes_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="访问令牌 (Bearer Token)"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:layout_marginTop="6dp" />

                <EditText
                    android:id="@+id/et_hermes_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="模型名称（留空自动获取）"
                    android:inputType="text"
                    android:maxLines="1"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btn_save_hermes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="保存AI设置"
                    android:textAllCaps="false"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Login / Logout -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="登录后台"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_logout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="退出登录"
            android:textAllCaps="false"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
