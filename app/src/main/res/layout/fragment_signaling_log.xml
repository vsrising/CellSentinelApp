<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="信令事件日志"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="?attr/textAppearanceTitleMedium">

        <!-- Toolbar action buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sig_ai"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI分析"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sig_export"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="导出"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite60" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sig_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开始监听"
                android:textAllCaps="false"
                app:backgroundTint="@color/colorWhite20"
                android:textColor="@color/white"
                android:layout_marginHorizontal="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sig_clear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清除"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite60" />

        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorOutlineVariant" />

    <!-- SIM filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sim_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部 SIM"
                android:checkable="true"
                android:checked="true"
                style="@style/AppChip"
                android:layout_marginEnd="6dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sim_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIM 1"
                android:checkable="true"
                style="@style/AppChip"
                android:layout_marginEnd="6dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sim_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIM 2"
                android:checkable="true"
                style="@style/AppChip" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorOutlineVariant" />

    <!-- Event type filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurfaceContainerLow"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部"
                android:checkable="true"
                android:checked="true"
                style="@style/AppChip"
                android:layout_marginEnd="6dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_handover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="切换"
                android:checkable="true"
                style="@style/AppChip"
                android:layout_marginEnd="6dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_rat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAT 变更"
                android:checkable="true"
                style="@style/AppChip"
                android:layout_marginEnd="6dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="服务状态"
                android:checkable="true"
                style="@style/AppChip" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorOutlineVariant" />

    <!-- Log output area -->
    <ScrollView
        android:id="@+id/sv_sig_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/colorSurfaceContainerLowest"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tv_sig_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.6"
            android:textColor="@color/textColorPrimary"
            android:text="点击开始监听以记录信令事件..." />

    </ScrollView>

</LinearLayout>
