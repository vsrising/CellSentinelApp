<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Full-screen Map ──────────────────────────────────────────── -->
    <org.osmdroid.views.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- ── GPS + recording status (top-left) ────────────────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/colorMapOverlay">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tv_gps_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="等待 GPS..."
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/textColorPrimary" />

            <TextView
                android:id="@+id/tv_record_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已录制 0 条"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/textColorPrimary" />

            <TextView
                android:id="@+id/tv_sim_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="测试: 卡2"
                android:textSize="11sp"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:background="@color/colorPrimaryTintBg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_metric_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="RSRP"
                android:textSize="11sp"
                android:textColor="@color/colorNr"
                android:textStyle="bold"
                android:background="@color/colorNrBg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="— km/h"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/textColorPrimary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_live_signal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="RSRP: — dBm"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/textColorPrimary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="min/avg/max"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textColor="@color/textColorMedium"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Measurement result (centered, GONE by default) ───────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_measure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/colorCardRecord">

        <TextView
            android:id="@+id/tv_measure_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/textColorPrimary" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ── Signal overlay (top-right, always visible) ──────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_signal_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/colorHudBg">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/tv_overlay_rsrp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RSRP  —"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_overlay_sinr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SINR  —"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tv_overlay_rsrq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RSRQ  —"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/white" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Zoom buttons (right side, center-vertical) ───────────────── -->
    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_zoom_in"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="+"
            android:textSize="18sp"
            android:textColor="@color/textColorPrimary"
            android:textAllCaps="false"
            android:padding="0dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginBottom="2dp" />

        <Button
            android:id="@+id/btn_zoom_out"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="−"
            android:textSize="18sp"
            android:textColor="@color/textColorPrimary"
            android:textAllCaps="false"
            android:padding="0dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginBottom="2dp" />

        <Button
            android:id="@+id/btn_locate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="⊙"
            android:textSize="16sp"
            android:textColor="@color/textColorPrimary"
            android:textAllCaps="false"
            android:padding="0dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

    <!-- ── Serving cell info (bottom bar, full-width minus compass) ─── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_cell_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="176dp"
        android:layout_marginBottom="0dp"
        android:visibility="gone"
        app:cardCornerRadius="6dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/colorCardDriveInfo">

        <TextView
            android:id="@+id/tv_cell_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:fontFamily="monospace"
            android:textSize="10.5sp"
            android:lineSpacingExtra="1.5dp"
            android:textColor="@color/textColorPrimary" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ── Playback controls (above compass, GONE by default) ────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_playback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="88dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/colorMapOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_playback_file"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="@color/textColorPrimary"
                    android:singleLine="true"
                    android:ellipsize="start"
                    android:text="未选择文件" />

                <Button
                    android:id="@+id/btn_playback_close"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="✕"
                    android:textSize="14sp"
                    android:textColor="@color/textColorSecondary"
                    android:padding="0dp" />

            </LinearLayout>

            <SeekBar
                android:id="@+id/seekbar_playback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp" />

            <TextView
                android:id="@+id/tv_playback_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/textColorSecondary"
                android:gravity="center"
                android:text="0 / 0 条" />

            <!-- Signal parameters during playback -->
            <TextView
                android:id="@+id/tv_playback_signal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="RSRP — dBm  SINR —  RSRQ —  PCI —"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btn_playback_prev"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="44dp"
                    android:layout_height="36dp"
                    android:text="⏮"
                    android:textSize="14sp"
                    android:padding="0dp"
                    android:textColor="@color/textColorPrimary"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_playback_play_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="▶ 播放"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_playback_speed"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="1×"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/textColorPrimary" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ── Mini signal chart (visible during recording) ───────────── -->
    <!-- marginEnd=150dp and marginBottom=115dp ensures no overlap with
         any compass child button at max 96dp expansion radius -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_mini_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="150dp"
        android:layout_marginBottom="115dp"
        android:visibility="gone"
        app:cardCornerRadius="6dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/colorMapOverlayChart">

        <com.asun.cellsentinelapp.view.SignalChartView
            android:id="@+id/mini_chart"
            android:layout_width="match_parent"
            android:layout_height="110dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════════════════════
         COMPASS – all items anchored bottom-right;
         child buttons animate outward when expanded.
         ══════════════════════════════════════════════════════════════ -->

    <!-- Compass disc background (appears when expanded) -->
    <View
        android:id="@+id/compass_disc"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="-30dp"
        android:layout_marginBottom="-30dp"
        android:background="@drawable/bg_compass_disc"
        android:alpha="0"
        android:visibility="invisible" />

    <!-- Child FAB: 开始/停止路测  (angle 90° = directly above) -->
    <Button
        android:id="@+id/fab_start_stop"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:text="开始\n路测"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.1"
        android:gravity="center"
        android:padding="4dp"
        android:background="@drawable/bg_compass_item"
        android:elevation="8dp"
        android:visibility="invisible" />

    <!-- Child FAB: 测距  (angle 112.5°) -->
    <Button
        android:id="@+id/fab_measure"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="测距"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="4dp"
        android:background="@drawable/bg_compass_item"
        android:elevation="8dp"
        android:visibility="invisible" />

    <!-- Child FAB: 刷新基站  (angle 135°) -->
    <Button
        android:id="@+id/fab_refresh"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="刷新\n基站"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.1"
        android:gravity="center"
        android:padding="4dp"
        android:background="@drawable/bg_compass_item"
        android:elevation="8dp"
        android:visibility="invisible" />

    <!-- Child FAB: 图层切换  (angle 157.5°) -->
    <Button
        android:id="@+id/fab_layer"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="地图\n图层"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.1"
        android:gravity="center"
        android:padding="4dp"
        android:background="@drawable/bg_compass_item"
        android:elevation="8dp"
        android:visibility="invisible" />

    <!-- Child FAB: 更多  (angle 180° = directly left) -->
    <Button
        android:id="@+id/fab_more"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="更多"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="4dp"
        android:background="@drawable/bg_compass_item"
        android:elevation="8dp"
        android:visibility="invisible" />

    <!-- Main compass button (always visible) -->
    <Button
        android:id="@+id/fab_main"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="☰"
        android:textAllCaps="false"
        android:textColor="@color/textColorBlack"
        android:textSize="22sp"
        android:gravity="center"
        android:background="@drawable/bg_compass_main"
        android:elevation="12dp" />

</RelativeLayout>
