<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- ── Operator + RAT header ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_operator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/textColorPrimary"
                android:text="—" />

            <TextView
                android:id="@+id/tv_rat_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/colorPrimary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <!-- ── Three signal gauges (DO NOT MODIFY these views) ──────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <com.asun.cellsentinelapp.view.SignalGaugeView
                android:id="@+id/gauge_rsrp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.asun.cellsentinelapp.view.SignalGaugeView
                android:id="@+id/gauge_sinr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp" />

            <com.asun.cellsentinelapp.view.SignalGaugeView
                android:id="@+id/gauge_rsrq"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- ── Cell identity card ────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <View
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        android:background="@color/colorPrimary"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        style="@style/SectionTitle"
                        android:text="小区标识" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView style="@style/CellLabel" android:text="CI / eNB" />
                    <TextView android:id="@+id/tv_ci_val"
                        style="@style/CellValue"
                        android:layout_weight="1" />
                    <TextView style="@style/CellLabel" android:text="PCI" />
                    <TextView android:id="@+id/tv_pci_val"
                        style="@style/CellValue"
                        android:layout_weight="1" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView style="@style/CellLabel" android:text="TAC" />
                    <TextView android:id="@+id/tv_tac_val"
                        style="@style/CellValue"
                        android:layout_weight="1" />
                    <TextView style="@style/CellLabel" android:text="MCC/MNC" />
                    <TextView android:id="@+id/tv_mcc_mnc_val"
                        style="@style/CellValue"
                        android:layout_weight="1" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView style="@style/CellLabel" android:text="EARFCN" />
                    <TextView android:id="@+id/tv_earfcn_val"
                        style="@style/CellValue"
                        android:layout_weight="1" />
                    <TextView style="@style/CellLabel" android:text="频段" />
                    <TextView android:id="@+id/tv_band_val"
                        style="@style/CellValue"
                        android:layout_weight="1"
                        android:textColor="@color/colorPrimary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Signal history chart ───────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <View
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        android:background="@color/colorAccent"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="信号历史 (120s)" />
                </LinearLayout>

                <com.asun.cellsentinelapp.view.SignalChartView
                    android:id="@+id/chart_signal"
                    android:layout_width="match_parent"
                    android:layout_height="150dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Network latency ───────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        android:background="@color/colorNr"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="网络延迟" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ping"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="测试"
                        android:textAllCaps="false"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:paddingHorizontal="14dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_ping_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:fontFamily="monospace"
                    android:textColor="@color/textColorSecondary"
                    android:text="点击测试按钮检测服务器延迟" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Neighbor cells ─────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <View
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        android:background="@color/colorAccentDark"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:id="@+id/tv_nbr_header"
                        style="@style/SectionTitle"
                        android:text="邻区 (0)" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_neighbors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/textColorPrimary"
                    android:text="—" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
