<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- ── Operator + RAT header ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tv_operator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#DE000000"
                android:text="—" />

            <TextView
                android:id="@+id/tv_rat_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#FF1565C0"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

        </LinearLayout>

        <!-- ── Three gauges ──────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <com.asun.cellsentinelapp.view.SignalGaugeView
                android:id="@+id/gauge_rsrp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.asun.cellsentinelapp.view.SignalGaugeView
                android:id="@+id/gauge_sinr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp" />

            <com.asun.cellsentinelapp.view.SignalGaugeView
                android:id="@+id/gauge_rsrq"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- ── Cell identity card ────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FAFAFA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Row 1: CI/eNB + PCI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView style="@style/CellLabel" android:text="CI / eNB" />
                    <TextView android:id="@+id/tv_ci_val"
                        style="@style/CellValue"
                        android:layout_weight="1" />
                    <TextView style="@style/CellLabel" android:text="PCI" />
                    <TextView android:id="@+id/tv_pci_val"
                        style="@style/CellValue"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Row 2: TAC + MCC/MNC -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView style="@style/CellLabel" android:text="TAC" />
                    <TextView android:id="@+id/tv_tac_val"
                        style="@style/CellValue"
                        android:layout_weight="1" />
                    <TextView style="@style/CellLabel" android:text="MCC/MNC" />
                    <TextView android:id="@+id/tv_mcc_mnc_val"
                        style="@style/CellValue"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Row 3: EARFCN + Band decode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView style="@style/CellLabel" android:text="EARFCN" />
                    <TextView android:id="@+id/tv_earfcn_val"
                        style="@style/CellValue"
                        android:layout_weight="1" />
                    <TextView style="@style/CellLabel" android:text="频段" />
                    <TextView android:id="@+id/tv_band_val"
                        style="@style/CellValue"
                        android:layout_weight="1"
                        android:textColor="#FF1565C0" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Signal history chart ───────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FAFAFA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="信号历史 (120s)"
                    android:textSize="11sp"
                    android:textColor="#99000000"
                    android:layout_marginBottom="4dp" />

                <com.asun.cellsentinelapp.view.SignalChartView
                    android:id="@+id/chart_signal"
                    android:layout_width="match_parent"
                    android:layout_height="160dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Network latency test ───────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FAFAFA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="网络延迟"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#DE000000" />

                    <Button
                        android:id="@+id/btn_ping"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="测试"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:paddingHorizontal="12dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_ping_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="#99000000"
                    android:text="点击测试按钮检测服务器延迟" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Neighbor cells ─────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FAFAFA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tv_nbr_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="邻区 (0)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#DE000000"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_neighbors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10.5sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#DE000000"
                    android:text="—" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
