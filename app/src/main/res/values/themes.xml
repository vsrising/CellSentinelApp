<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme – forced light mode. -->
    <style name="Theme.CellSentinelApp" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccentDark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Surface: MaterialCardView and sheet backgrounds. -->
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/textColorPrimary</item>
        <!-- Window / screen background. -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <!-- Global text colors – drives TextInputEditText, EditText, general text. -->
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorSecondary</item>
        <item name="android:textColorHint">@color/textColorHint</item>
        <!-- Global component styles. -->
        <item name="materialCardViewStyle">@style/AppCardView</item>
        <item name="editTextStyle">@style/AppEditText</item>
        <item name="chipStyle">@style/AppChip</item>
    </style>

    <style name="Theme.CellSentinelApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- ── Global MaterialCardView ─────────────────────────────────────── -->
    <style name="AppCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/colorSurfaceFaint</item>
        <item name="strokeColor">@color/colorPrimaryTintBg</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ── TextInputLayout – OutlinedBox.Dense (default for tools/forms) ── -->
    <style name="AppTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="hintTextColor">@color/textColorSecondary</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="boxStrokeErrorColor">@color/colorAccent</item>
    </style>

    <!-- ── TextInputLayout – OutlinedBox (larger, for login page) ──────── -->
    <style name="AppTextInputBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/textColorSecondary</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="boxStrokeErrorColor">@color/colorAccent</item>
    </style>

    <!-- ── Standalone EditText (dialog, profile) ────────────────────────── -->
    <style name="AppEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textColorHint">@color/textColorHint</item>
    </style>

    <!-- ── Chip.Filter with app color scheme ────────────────────────────── -->
    <style name="AppChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipStrokeColor">@color/colorPrimaryTintBg</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <!-- ── Cell info card label/value styles ────────────────────────────── -->
    <style name="CellLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:textColor">@color/textColorSecondary</item>
        <item name="android:layout_marginEnd">3dp</item>
    </style>

    <style name="CellValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <!-- ── Section card title ────────────────────────────────────────────── -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
</resources>
